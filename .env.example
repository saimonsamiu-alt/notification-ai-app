# এই ফাইলটা কপি করে .env নামে সেভ করো, তারপর নিজের তথ্য বসাও

# --- Email (Gmail হলে App Password লাগবে, সাধারণ পাসওয়ার্ড কাজ করবে না) ---
# App Password বানানোর জায়গা: https://myaccount.google.com/apppasswords
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USER=youremail@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# --- Telegram ---
# @BotFather কে মেসেজ করে "/newbot" দিয়ে একটা বট বানাও, টোকেন এখানে বসাও
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- ফিল্টার সেটিংস (নিজের মতো পরিবর্তন করো) ---
VIP_SENDERS=boss@example.com,ma@example.com
IMPORTANT_KEYWORDS=urgent,asap,জরুরি,deadline,important,fund,payment,invoice
